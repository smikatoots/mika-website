{
  "name": "mika-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev",
    "gen:image-dims": "tsx scripts/generate-image-dimensions.ts",
    "prebuild": "yarn lint && tsx scripts/generate-image-dimensions.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && tsx scripts/verify-seo.ts",
    "verify:seo": "tsx scripts/verify-seo.ts",
    "verify:seo:site": "tsx scripts/verify-seo-site.ts",
    "process:logo": "tsx scripts/make-logo-transparent.ts",
    "sync:blog": "node -r ./scripts/bootstrap-env.cjs node_modules/.bin/tsx scripts/sync-notion-blog.ts",
    "sync:blog:force": "node -r ./scripts/bootstrap-env.cjs node_modules/.bin/tsx scripts/sync-notion-blog.ts --force",
    "sync:projects": "node -r ./scripts/bootstrap-env.cjs node_modules/.bin/tsx scripts/sync-notion-projects.ts",
    "sync:press": "node -r ./scripts/bootstrap-env.cjs node_modules/.bin/tsx scripts/sync-notion-press.ts",
    "match:legacy-blog": "node -r ./scripts/bootstrap-env.cjs node_modules/.bin/tsx scripts/match-legacy-blog-urls.ts",
    "changelog:urls": "node -r ./scripts/bootstrap-env.cjs node_modules/.bin/tsx scripts/generate-url-migration-changelog.ts",
    "sync:url-redirects": "node scripts/sync-url-redirects-from-changelog.mjs",
    "verify:legacy-urls": "node scripts/verify-legacy-urls.mjs",
    "verify:legacy-urls:relax": "node scripts/verify-legacy-urls.mjs --allow-missing-blog"
  },
  "dependencies": {
    "@notionhq/client": "^5.16.0",
    "gray-matter": "^4.0.3",
    "next": "16.2.2",
    "next-mdx-remote": "^6.0.0",
    "posthog-js": "^1.391.2",
    "posthog-node": "^5.29.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "notion-to-md": "^3.1.9",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
