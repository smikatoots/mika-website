# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# deck media — presentation decks are local-only (noindexed, recorded from
# localhost, never linked). Keep the heavy movs/gifs/images out of git and off
# the Vercel deploy. Deck page source under src/app/deck stays tracked.
/public/decks/_library/

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
.pi-subagents
remotion-video/
.indexnow-snapshot.json
